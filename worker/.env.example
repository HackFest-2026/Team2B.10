# Local Ollama server (host or container)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:14b
# Must be the same directory the backend uses (shared volume in docker)
STORAGE_DIR=../storage
INSIGHT_CONCURRENCY=1
# 1 = one Ollama call per key paragraph of PDFs/scans for highlights and notes (slow on small machines).
# 0 = skip it: PDFs open without highlights, the graph has no claims.
GENERATE_INSIGHTS=1
