# The frontend's default API URL is http://localhost:5001/api
PORT=5001
MONGO_URI=mongodb://localhost:27017/mirage
FRONTEND_URL=http://localhost:3000
WORKER_URL=http://localhost:8000
# Required: openssl rand -hex 32  (the API refuses to start without it)
JWT_SECRET=
# Shared with the worker (same directory)
STORAGE_DIR=../storage
# Private signing key for exports; keep it out of any volume the worker can read
SIGNING_KEY_DIR=../keys
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:14b
